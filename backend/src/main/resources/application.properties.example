# ==============================================================
# SmartShelfX Backend - Example Configuration Template
# Copy this file to application.properties and customize credentials.
# ==============================================================

server.port=8080
spring.application.name=smartshelfx-backend

# MySQL Connection Details
spring.datasource.url=jdbc:mysql://localhost:3306/smartshelfx?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_DATABASE_USERNAME
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Settings (Generate a secure 256-bit hexadecimal key for production)
jwt.secret=YOUR_HEX_ENCODED_256_BIT_SECRET_KEY_HERE
jwt.expiration-ms=86400000

# AI Forecasting Engine URL
ai.service.url=http://localhost:5000
ai.service.timeout-ms=5000
